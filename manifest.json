{
  "manifest_version": 3,
  "name": "Copy-Paste Unlock",
  "version": "1.1",
  "description": "Re-enables copy, cut, paste, right-click, and text selection on pages that block them.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy-Paste Unlock"
  },
  "icons": {
    "48": "icon.png"
  }
}

{
  "manifest_version": 3,
  "name": "Copy-Paste Unlock",
  "version": "1.0",
  "description": "Re-enables copy, cut, paste, right-click, and text selection on pages that block them.",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy-Paste Unlock"
  },
  "icons": {
    "48": "icon.png"
  }
}
